---
import Base from '../layouts/Base.astro';
import Billet from '../components/Billet.astro';
import { listerExpeditions, listerMondes } from '../lib/strapi.js';

let expeditions = [];
let mondes = [];
let erreur = null;
try {
  [expeditions, mondes] = await Promise.all([listerExpeditions(), listerMondes()]);
} catch (e) {
  erreur = e.message;
}
---

<Base>
  <section class="accueil">
    <svg class="relief" viewBox="0 0 600 300" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M420 150c0-60 60-95 110-80s70 70 40 115-110 55-140 20-10-55-10-55z" />
        <path d="M385 150c0-85 85-135 155-115s100 100 55 160-150 80-195 30-15-75-15-75z" />
        <path d="M350 155c-5-110 110-175 200-150s135 130 75 205-195 105-255 40-20-95-20-95z" />
        <path d="M310 160c-10-135 135-215 245-185" />
        <path d="M60 260c40-50 110-40 140-5" />
        <path d="M30 290c55-85 170-80 215-5" />
      </g>
    </svg>

    <div class="conteneur">
      <h1>Où part&#8209;on aujourd’hui&nbsp;?</h1>
      <p class="intro">
        Choisis une expédition. En chemin, tu trouveras des devinettes, des mots magiques et des défis à faire pour de vrai.
      </p>

      {
        mondes.length > 0 && (
          <nav aria-label="Les mondes">
            <ul class="mondes">
              {mondes.map((m) => (
                <li>
                  <a href={`/monde/${m.slug}`} style={m.couleur ? `--pastille: ${m.couleur}` : undefined}>
                    <span aria-hidden="true">{m.emoji}</span> {m.nom}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </section>

  <section class="conteneur depart">
    <h2>Les expéditions</h2>

    {
      erreur && (
        <div class="message" role="alert">
          <p><strong>Les expéditions n’ont pas pu être chargées.</strong></p>
          <p>{erreur}</p>
        </div>
      )
    }

    {
      !erreur && expeditions.length === 0 && (
        <div class="message">
          <p><strong>Aucune expédition publiée pour l’instant.</strong></p>
          <p>
            Créez-en une dans l’admin de Strapi (<a href="http://localhost:1337/admin">localhost:1337/admin</a>) puis cliquez
            sur « Publish ».
          </p>
        </div>
      )
    }

    <ul class="billets">
      {expeditions.map((e) => <Billet expedition={e} />)}
    </ul>
  </section>
</Base>

<style>
  .accueil {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 4rem;
  }

  .relief {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--trait);
    z-index: -1;
    mask-image: linear-gradient(#000 55%, transparent);
  }

  h1 {
    font-size: var(--t-4);
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 12ch;
  }

  .intro {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: var(--t-1);
    line-height: 1.5;
  }

  .mondes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .mondes a {
    display: inline-flex;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--encre);
    border-left: 10px solid var(--pastille, var(--encre));
    border-radius: 999px;
    background: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .mondes a:hover {
    background: var(--papier-fonce);
  }

  .depart h2 {
    font-size: var(--t-3);
    margin-bottom: 1.5rem;
  }

  .billets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .message {
    max-width: 40rem;
    padding: 1.25rem 1.5rem;
    border: 2px dashed var(--encre-douce);
    border-radius: 14px;
  }

  .message p:last-child {
    margin-bottom: 0;
  }
</style>
