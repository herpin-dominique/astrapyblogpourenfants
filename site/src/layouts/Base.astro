---
import '../styles/global.css';

const { titre, description = 'Des expéditions à lire, à deviner et à vivre, pour les enfants de 4 à 12 ans.', ambiance } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{titre ? `${titre} · Carnet de route` : 'Carnet de route'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-ambiance={ambiance}>
    <header class="entete conteneur">
      <a href="/" class="marque">
        <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
          <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2.5" />
          <path d="M16 5 L20 16 L16 27 L12 16 Z" fill="currentColor" />
          <circle cx="16" cy="16" r="2.2" fill="var(--papier)" />
        </svg>
        Carnet de route
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pied conteneur">
      <p>Chaque question est une porte. Bonne route&nbsp;!</p>
    </footer>
  </body>
</html>

<style>
  .entete {
    padding-block: 1.25rem;
  }

  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--titre);
    font-weight: 800;
    font-size: var(--t-1);
    text-decoration: none;
  }

  .pied {
    margin-top: 6rem;
    padding-block: 2rem 3rem;
    border-top: 2px dashed var(--trait);
    color: var(--encre-douce);
  }
</style>
