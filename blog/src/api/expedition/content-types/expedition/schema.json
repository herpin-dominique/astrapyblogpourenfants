{
  "kind": "collectionType",
  "collectionName": "expeditions",
  "info": {
    "singularName": "expedition",
    "pluralName": "expeditions",
    "displayName": "Expédition",
    "description": "Un article du blog, vécu comme une expédition en plusieurs étapes"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "accroche": {
      "type": "text",
      "maxLength": 160,
      "required": true
    },
    "couverture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "ambiance": {
      "type": "enumeration",
      "enum": ["calme", "rigolo", "mystere", "intrepide", "reveur"],
      "default": "intrepide",
      "required": true
    },
    "age": {
      "type": "enumeration",
      "enum": ["a_partir_de_4_ans", "a_partir_de_7_ans", "a_partir_de_10_ans"],
      "required": true
    },
    "narration": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["audios"]
    },
    "tempsDeLecture": {
      "type": "integer",
      "min": 1
    },
    "etapes": {
      "type": "dynamiczone",
      "components": [
        "etape.recit",
        "etape.devinette",
        "etape.mot-magique",
        "etape.mini-quiz",
        "etape.defi",
        "etape.illustration"
      ],
      "required": true,
      "min": 1
    },
    "monde": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::monde.monde",
      "inversedBy": "expeditions"
    },
    "guide": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::guide.guide",
      "inversedBy": "expeditions"
    }
  }
}
